<?xml version='1.0' encoding='utf-8'?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>rospacer_udp</transport_id>
        <type>UDPv4</type>
        <maxMessageSize>1472</maxMessageSize>
        <sendBufferSize>100000</sendBufferSize>
        <receiveBufferSize>1048576</receiveBufferSize>
        <interfaceWhiteList>
          <address>192.168.0.3</address>
        </interfaceWhiteList>
        <non_blocking_send>false</non_blocking_send>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="rospacer_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>rospacer_udp</transport_id>
        </userTransports>
      </rtps>
    </participant>
    <publisher profile_name="rospacer_publisher" is_default_profile="true">
      <topic>
        <kind>NO_KEY</kind>
        <historyQos>
          <kind>KEEP_ALL</kind>
          <depth>11</depth>
        </historyQos>
        <resourceLimitsQos>
          <max_samples>11</max_samples>
          <max_samples_per_instance>11</max_samples_per_instance>
          <allocated_samples>11</allocated_samples>
          <max_instances>1</max_instances>
        </resourceLimitsQos>
      </topic>
      <qos>
        <reliability>
          <kind>RELIABLE</kind>
          <max_blocking_time>
            <sec>1</sec>
            <nanosec>0</nanosec>
          </max_blocking_time>
        </reliability>
        <publishMode>
          <kind>SYNCHRONOUS</kind>
        </publishMode>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
      <times>
        <heartbeatPeriod>
          <sec>0</sec>
          <nanosec>50000000</nanosec>
        </heartbeatPeriod>
      </times>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </publisher>
    <subscriber profile_name="rospacer_subscriber" is_default_profile="true">
      <topic>
        <kind>NO_KEY</kind>
        <historyQos>
          <kind>KEEP_ALL</kind>
          <depth>11</depth>
        </historyQos>
        <resourceLimitsQos>
          <max_samples>11</max_samples>
          <max_samples_per_instance>11</max_samples_per_instance>
          <allocated_samples>11</allocated_samples>
          <max_instances>1</max_instances>
        </resourceLimitsQos>
      </topic>
      <qos>
        <reliability>
          <kind>RELIABLE</kind>
          <max_blocking_time>
            <sec>1</sec>
            <nanosec>0</nanosec>
          </max_blocking_time>
        </reliability>
      </qos>
      <times>
        <heartbeatResponseDelay>
          <sec>0</sec>
          <nanosec>5000000</nanosec>
        </heartbeatResponseDelay>
      </times>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </subscriber>
  </profiles>
</dds>